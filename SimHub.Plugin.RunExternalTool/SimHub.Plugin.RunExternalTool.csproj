<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimHub.Plugin.RunExternalTool</RootNamespace>
    <AssemblyName>SimHub.Plugin.RunExternalTool</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>

    <Version>0.9.0</Version>
    <Authors>jbudworth</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/jbudworth/SimHub-Plugin-RunExternalTool</RepositoryUrl>

    <!-- Change this if SimHub is installed somewhere else. -->
    <SimHubInstallDir Condition="'$(SimHubInstallDir)' == ''">C:\Program Files (x86)\SimHub\</SimHubInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- These ship inside every SimHub installation. -->
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubInstallDir)SimHub.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubInstallDir)GameReaderCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>$(SimHubInstallDir)SimHub.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SimHubInstallDir)log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.png" />
  </ItemGroup>

  <!-- Drop the built DLL straight into SimHub's plugin folder so F5 debugging works. -->
  <Target Name="CopyToSimHub" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SimHubInstallDir)" ContinueOnError="true" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <StartAction>Program</StartAction>
    <StartProgram>$(SimHubInstallDir)SimHubWPF.exe</StartProgram>
    <StartWorkingDirectory>$(SimHubInstallDir)</StartWorkingDirectory>
  </PropertyGroup>

</Project>
